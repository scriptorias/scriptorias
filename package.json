{
  "name": "scriptorias",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && vite build",
    "preview": "vite preview",
    "build:alias-fixture": "VITE_REF_ALIAS_FIXTURE=1 vite build --outDir dist-alias-fixture",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "npm run build && playwright test",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:import": "tsx scripts/content/import.ts",
    "content:import-lightfoot": "tsx scripts/content/import-lightfoot-1891.ts",
    "content:check": "tsx scripts/content/import.ts --check && tsx scripts/content/import-lightfoot-1891.ts --check && tsx scripts/content/validate.ts",
    "test:content": "tsx --test tests/content/*.test.ts",
    "release:simulate": "tsx scripts/content/simulate-release.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  }
}
